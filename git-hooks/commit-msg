#!/bin/bash
#
# Conventional Commits validator.
# Глобальний хук: ~/.claude/git-hooks/commit-msg
# Обійти один раз:  git commit --no-verify
# Вимкнути в одному репо:  git config core.hooksPath .git/hooks

MSG_FILE="$1"

# Прибираємо коментарі та порожні рядки на початку
CONTENT=$(grep -v '^#' "$MSG_FILE" | awk 'NF {found=1} found')
SUBJECT=$(printf '%s\n' "$CONTENT" | sed -n '1p')
LINE2=$(printf '%s\n' "$CONTENT" | sed -n '2p')

# Порожнє повідомлення — git сам відхилить
[ -z "$SUBJECT" ] && exit 0

# Автогенеровані коміти пропускаємо
case "$SUBJECT" in
  Merge\ *|Revert\ *|fixup!*|squash!*|amend!*|Initial\ commit) exit 0 ;;
esac

TYPES='feat|fix|docs|chore|refactor|style|perf|test|ci|build|revert'
PATTERN="^($TYPES)(\([a-zA-Z0-9._/-]+\))?!?: .+"

fail() {
  echo ""
  echo "  ✗ Коміт відхилено: $1"
  echo ""
  echo "  Твоє повідомлення:"
  echo "    $SUBJECT"
  echo ""
}

if ! printf '%s' "$SUBJECT" | grep -Eq "$PATTERN"; then
  fail "формат не відповідає Conventional Commits"
  echo "  Потрібно:  <type>(<scope>): <опис>"
  echo ""
  echo "  Основні типи:"
  echo "    feat:      щось нове з'явилось"
  echo "    fix:       щось було зламано і виправлено"
  echo "    docs:      текст, README, документація"
  echo "    chore:     рутина (залежності, конфіги)"
  echo "    refactor:  структура коду, вигляд не змінився"
  echo ""
  echo "  Рідше: style (форматування коду, НЕ візуал), perf, test, ci, build, revert"
  echo ""
  echo "  Приклади:"
  echo "    docs: update bio and add Behance link"
  echo "    feat(nav): add mobile menu"
  echo "    fix: prevent long titles from breaking card layout"
  echo ""
  echo "  Не забудь двокрапку й ПРОБІЛ після типу."
  echo ""
  exit 1
fi

# Якщо є тіло — після заголовка мусить бути порожній рядок
if [ -n "$LINE2" ]; then
  fail "після заголовка потрібен порожній рядок"
  echo "  Тіло коміту мусить починатись через один порожній рядок,"
  echo "  інакше воно приклеїться до заголовка."
  echo ""
  echo "  Правильно:"
  echo "    fix: prevent duplicate orders"
  echo "    "
  echo "    Кнопка не блокувалась під час запиту."
  echo ""
  exit 1
fi

# Попередження — не блокують коміт
LEN=${#SUBJECT}
if [ "$LEN" -gt 72 ]; then
  echo ""
  echo "  ⚠  Заголовок довгий ($LEN симв., бажано до 72) — у списках обріжеться."
fi

case "$SUBJECT" in
  *.) echo ""; echo "  ⚠  Крапка в кінці заголовка — зазвичай її не ставлять." ;;
esac

DESC=${SUBJECT#*: }
case "$DESC" in
  [A-ZА-ЯЇІЄҐ]*) echo ""; echo "  ⚠  Опис з великої літери — за конвенцією з малої." ;;
esac

for w in Added Updated Fixed Added: added updated fixed adding updating fixing; do
  case "$DESC" in
    "$w "*) echo ""; echo "  ⚠  '$w' — краще наказовий спосіб: add, update, fix." ; break ;;
  esac
done

exit 0
